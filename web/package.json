{
  "name": "mote-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "verify:dist": "node scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "live:e2e": "node scripts/live-e2e.mjs",
    "test:visual": "npm run build && playwright test --config=playwright.visual.config.mjs",
    "test:visual:update": "npm run build && playwright test --config=playwright.visual.config.mjs --update-snapshots",
    "test": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "^30.0.1",
    "playwright": "1.57.0",
    "typescript": "5.6.3",
    "vite": "6.4.3"
  }
}
